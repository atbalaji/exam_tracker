<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-md bg-white rounded-lg shadow p-6 space-y-6">

    <div class="text-center">
      <h1 class="text-2xl font-bold">Sign Up</h1>
      <p class="text-gray-600 text-sm">
        Create a new account to track your mocks
      </p>
    </div>

    <%= form_with url: signup_path, class: "space-y-4" do %>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Email
        </label>
        <%= text_field_tag "email", nil,
              class: "w-full rounded-md border border-gray-300 px-3 py-2
                      focus:outline-none focus:ring-2 focus:ring-indigo-500
                      focus:border-indigo-500",
              required: true,
              autofocus: true %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Name
        </label>
        <%= text_field_tag "name", nil,
              class: "w-full rounded-md border border-gray-300 px-3 py-2
                      focus:outline-none focus:ring-2 focus:ring-indigo-500
                      focus:border-indigo-500",
              required: true,
              autofocus: true %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Password
        </label>
        <%= password_field_tag "password", nil,
              class: "w-full rounded-md border border-gray-300 px-3 py-2
                      focus:outline-none focus:ring-2 focus:ring-indigo-500
                      focus:border-indigo-500",
              required: true %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Password Confirmation
        </label>
        <%= password_field_tag "password_confirmation", nil,
              class: "w-full rounded-md border border-gray-300 px-3 py-2
                      focus:outline-none focus:ring-2 focus:ring-indigo-500
                      focus:border-indigo-500",
              required: true %>
      </div>

      <div>
        <%= submit_tag "Sign Up",
              class: "w-full bg-indigo-600 text-white py-2 rounded-md
                      hover:bg-indigo-700 transition font-medium" %>
      </div>

    <% end %>

    <!-- Future expansion zone -->
   <div class="pt-6 border-t text-center">
      <p class="text-sm text-gray-500">
        Already have an account?
        <%= link_to 'Sign in',
            login_path,
            class: 'ml-1 font-semibold text-indigo-600 hover:text-indigo-500 transition'
        %>
      </p>
    </div>


  </div>
</div>
